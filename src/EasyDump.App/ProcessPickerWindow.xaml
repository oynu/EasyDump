<Window x:Class="EasyDump.App.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Running Game Process"
        Width="780"
        Height="520"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Select Running Game Process" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="EasyDump resolves the selected process's executable path on disk to inspect its local game files."
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="12"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Search + Refresh + System filter -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="SearchBox"
                         Padding="28,6,8,6"
                         TextChanged="SearchBox_TextChanged" />
                <Path Data="{StaticResource IconSearch}"
                      Stroke="{StaticResource BrushTextMuted}"
                      StrokeThickness="1.6"
                      Width="13"
                      Height="13"
                      Stretch="Uniform"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"
                      IsHitTestVisible="False" />
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Filter by process name, window title, PID, or path..."
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="12"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <ToggleButton x:Name="ShowSystemToggle"
                          Grid.Column="1"
                          Style="{StaticResource FilterChipStyle}"
                          Content="Show Windows"
                          Margin="0,0,8,0"
                          Checked="FilterToggle_Changed"
                          Unchecked="FilterToggle_Changed" />

            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Refresh_Click"
                    ToolTip="Refresh process list">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Process DataGrid -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <DataGrid x:Name="ProcessGrid"
                      MouseDoubleClick="ProcessGrid_MouseDoubleClick"
                      SelectionChanged="ProcessGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="68" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextMuted}" />
                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="165" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Engine" Binding="{Binding EngineHint}" Width="105" Foreground="{StaticResource BrushAccent}" />
                    <DataGridTextColumn Header="Window Title" Binding="{Binding WindowTitle}" Width="180" Foreground="{StaticResource BrushTextSecondary}" />
                    <DataGridTextColumn Header="Executable Path" Binding="{Binding ExecutablePath}" Width="*" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="11.5"
                       VerticalAlignment="Center" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Cancel"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="SelectBtn"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Select Process"
                        IsEnabled="False"
                        Click="Select_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
