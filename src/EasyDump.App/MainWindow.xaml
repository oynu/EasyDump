<Window x:Class="EasyDump.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyDump.App.ViewModels"
        Title="EasyDump"
        Width="1340"
        Height="840"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Top Header / Game Selection & Primary Actions -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Brand + Select Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource BrushAccentSubtle}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" Margin="0,0,9,0">
                            <Path Data="{StaticResource IconTerminal}" Stroke="{StaticResource BrushAccent}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="EasyDump" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectFolderCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Select a game installation directory">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="Select Folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectFileCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Select an executable, DLL, ELF binary, or global-metadata.dat">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFile}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="Select File" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectProcessCommand}"
                            ToolTip="Pick a running game process to locate and inspect its files on disk">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconProcess}" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="Select Process" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: Detected Target Summary -->
                <Border Grid.Column="1"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BrushBgElevated}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,5"
                        Margin="16,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GameName}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="240"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding SelectedPath}" />

                            <Border Background="{StaticResource BrushAccentSubtle}"
                                    BorderBrush="{StaticResource BrushAccent}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding EngineDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" />
                            </Border>

                            <TextBlock Text="{Binding ArchitectureDisplay}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11.5"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsUnityGame, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="·" Foreground="{StaticResource BrushTextMuted}" Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Unity " Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UnityVersionDisplay}" Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource FontMono}" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding MetadataVersionDisplay, Converter={StaticResource NullToVis}}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="·" Foreground="{StaticResource BrushTextMuted}" Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Meta " Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MetadataVersionDisplay}" Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource FontMono}" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding DetectedFiles.Count, StringFormat={}{0} file(s)}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11.5"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Right: Analyse / Cancel / Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartAnalysisCommand}"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource InverseBoolToVis}}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="Start Analysis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelAnalysisCommand}"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconStop}" Fill="{StaticResource BrushError}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="Cancel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ForceReanalyzeCommand}"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
                            ToolTip="Force fresh re-analysis (bypass cache)"
                            Padding="8,7"
                            Margin="0,0,6,0">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                    </Button>

                    <Grid>
                        <Button x:Name="ExportButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleExportPopupCommand}"
                                IsEnabled="{Binding HasResults}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExport}" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" />
                                <TextBlock Text="Export" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsExportPopupOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=ExportButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource BrushBgElevated}"
                                    BorderBrush="{StaticResource BrushBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,4,0,0"
                                    Width="270">
                                <StackPanel>
                                    <TextBlock Text="Export Offsets" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                                    <TextBlock Text="Format" Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ExportFormats}"
                                              SelectedItem="{Binding SelectedExportFormat}"
                                              Margin="0,0,0,10" />

                                    <TextBlock Text="Scope" Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ExportScopes}"
                                              SelectedItem="{Binding SelectedExportScope}"
                                              Margin="0,0,0,14" />

                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ExportCommand}"
                                            Content="Save Export File..." />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Progress Strip & Error Banner -->
        <StackPanel Grid.Row="1">
            <!-- Active / Status strip when analyzing -->
            <Border Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <ProgressBar Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Maximum="100" />
                    <DockPanel Margin="16,6">
                        <TextBlock Text="{Binding CurrentStage}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushAccent}"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource BrushErrorBg}"
                    BorderBrush="{StaticResource BrushError}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleDiagnosticsCommand}"
                            Content="View Diagnostics"
                            Padding="9,4"
                            FontSize="11.5" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconWarning}" Stroke="{StaticResource BrushError}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding ErrorBannerMessage}" Foreground="#FCA5A5" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ROW 2: Main Content -->
        <Grid Grid.Row="2">
            <!-- Empty / Welcome State -->
            <Grid Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}">
                <Border MaxWidth="620"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="36,34">
                    <StackPanel>
                        <TextBlock Text="Extract and Verify Game Offsets"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Select a local Unity (IL2CPP or Mono) installation, managed assembly, or native PE/ELF binary — or drag and drop it onto this window."
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,22" />

                        <!-- Clean 4-step indicator -->
                        <UniformGrid Columns="4" Margin="0,0,0,24">
                            <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="1. Select" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Text="Folder or binary" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="2. Analyse" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Text="Parse metadata" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="3. Browse" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Text="Search &amp; verify" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="4. Export" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Text="JSON, TXT, CSV" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SelectFolderCommand}"
                                    Padding="16,9"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Select Game Folder" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectFileCommand}"
                                    Padding="16,9"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFile}" Fill="{StaticResource BrushTextSecondary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Select Binary / Metadata" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectProcessCommand}"
                                    Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconProcess}" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Select Running Process" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- If target is already selected before clicking Start Analysis, show quick action -->
                        <Border Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource BrushAccentSubtle}"
                                BorderBrush="{StaticResource BrushAccent}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="0,20,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartAnalysisCommand}"
                                        Content="Start Analysis" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Results 3-Pane Workspace -->
            <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="230" MaxWidth="480" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="310" MinWidth="240" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: Search, Filters, Assemblies, Classes -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <Grid Grid.Row="0" Margin="10,10,10,8">
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="28,6,26,6"
                                     ToolTip="Search classes, namespaces, fields, methods, or hex offsets" />
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource BrushTextMuted}"
                                  StrokeThickness="1.6"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  IsHitTestVisible="False" />
                            <TextBlock Text="Search classes, members, offsets..."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="12"
                                       Margin="30,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchQuery, Converter={StaticResource InverseNullToVis}}" />
                        </Grid>

                        <!-- Filter Chips & Sort -->
                        <WrapPanel Grid.Row="1" Margin="10,0,10,8" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource FilterChipStyle}"
                                          IsChecked="{Binding HideSystemAssemblies}"
                                          Content="Game Only"
                                          ToolTip="Hide System.*, UnityEngine.*, and Mono.* assemblies"
                                          Margin="0,0,6,4" />
                            <ToggleButton Style="{StaticResource FilterChipStyle}"
                                          IsChecked="{Binding ConfirmedOnly}"
                                          Content="Confirmed"
                                          ToolTip="Show only types/members with confirmed offsets"
                                          Margin="0,0,6,4" />
                            <ComboBox ItemsSource="{Binding SortModes}"
                                      SelectedItem="{Binding SortMode}"
                                      Width="92"
                                      Padding="7,3"
                                      FontSize="11.5"
                                      ToolTip="Sort classes and members"
                                      Margin="0,0,0,4" />
                        </WrapPanel>

                        <!-- Assembly Selector -->
                        <StackPanel Grid.Row="2" Margin="10,0,10,8">
                            <ComboBox ItemsSource="{Binding AssemblyChoices}"
                                      SelectedItem="{Binding SelectedAssemblyChoice}"
                                      DisplayMemberPath="DisplayLabel" />
                            <TextBlock Text="{Binding FilteredTypes.Count, StringFormat={}{0:N0} types}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="11"
                                       Margin="2,6,0,0" />
                        </StackPanel>

                        <!-- Virtualized Class List -->
                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding FilteredTypes}"
                                 SelectedItem="{Binding SelectedType}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="10,7" />
                                    <Setter Property="Margin" Value="6,1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplayNamespace}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TotalMembers, StringFormat={}{0}}" Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource FontMono}" FontSize="11" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Kind}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- CENTER PANE: Selected Class Header + Fields / Methods Tabs -->
                <Grid Grid.Column="2" Background="{StaticResource BrushBgWindow}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Class Header -->
                    <Border Grid.Row="0"
                            Visibility="{Binding SelectedType, Converter={StaticResource NullToVis}}"
                            Background="{StaticResource BrushBgSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CopySelectedTypeCommand}"
                                    VerticalAlignment="Center"
                                    ToolTip="Copy full class dump to clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="Copy Class" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedType.Kind}" Foreground="{StaticResource BrushAccent}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedType.FullName}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedType.AssemblyName}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5" />
                                    <TextBlock Text=" · Token " Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" />
                                    <TextBlock Text="{Binding SelectedType.TokenHex}" Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource FontMono}" FontSize="11.5" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedType.BaseType, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text=" · Base " Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" />
                                        <TextBlock Text="{Binding SelectedType.BaseType}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Fields / Methods TabControl -->
                    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedMemberTabIndex}">
                        <!-- FIELDS TAB -->
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="{Binding VisibleFields.Count, StringFormat=Fields ({0})}" />
                            </TabItem.Header>
                            <DataGrid ItemsSource="{Binding VisibleFields}"
                                      SelectedItem="{Binding SelectedField}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field Name" Binding="{Binding Name}" Width="190" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding FieldType}" Width="180" Foreground="{StaticResource BrushTextSecondary}" />
                                    <DataGridTemplateColumn Header="Offset / RVA" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PrimaryOffsetDisplay}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="12"
                                                           Foreground="{Binding OverallStatus, Converter={StaticResource StatusFgBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Token" Binding="{Binding TokenHex}" Width="95" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextMuted}" />
                                    <DataGridTemplateColumn Header="Status" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding OverallStatus, Converter={StaticResource StatusBgBrush}}"
                                                        CornerRadius="3"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding OverallStatus}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding OverallStatus, Converter={StaticResource StatusFgBrush}}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.CopyFieldLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Copy field signature and offset">
                                                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- METHODS TAB -->
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="{Binding VisibleMethods.Count, StringFormat=Methods ({0})}" />
                            </TabItem.Header>
                            <DataGrid ItemsSource="{Binding VisibleMethods}"
                                      SelectedItem="{Binding SelectedMethod}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Method" Binding="{Binding Name}" Width="180" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Return" Binding="{Binding ReturnType}" Width="110" Foreground="{StaticResource BrushTextSecondary}" />
                                    <DataGridTemplateColumn Header="RVA" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RvaDisplay}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="12"
                                                           Foreground="{Binding OverallStatus, Converter={StaticResource StatusFgBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Virtual Addr" Binding="{Binding VirtualAddressDisplay}" Width="135" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextSecondary}" />
                                    <DataGridTextColumn Header="File Offset" Binding="{Binding FileOffsetDisplay}" Width="105" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextMuted}" />
                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding OverallStatus, Converter={StaticResource StatusBgBrush}}"
                                                        CornerRadius="3"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding OverallStatus}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding OverallStatus, Converter={StaticResource StatusFgBrush}}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.CopyMethodLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Copy method signature and offsets">
                                                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- RIGHT PANE: Member Details Inspector -->
                <Border Grid.Column="4"
                        Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1,0,0,0"
                        Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="INSPECTOR" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />

                            <TextBlock Text="{Binding InspectorTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InspectorSubtitle}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10" />

                            <Border Visibility="{Binding HasInspectorSelection, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource BrushBgElevated}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding CopyTextCommand}"
                                            CommandParameter="{Binding InspectorSignature}"
                                            ToolTip="Copy signature"
                                            VerticalAlignment="Top">
                                        <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" />
                                    </Button>
                                    <TextBox Text="{Binding InspectorSignature, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             Padding="0" />
                                </DockPanel>
                            </Border>

                            <!-- Extracted Offsets Cards -->
                            <ItemsControl ItemsSource="{Binding InspectorOffsets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgElevated}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10,9"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding CopyValue}"
                                                            IsEnabled="{Binding HasCopyValue}"
                                                            ToolTip="Copy offset value">
                                                        <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>

                                                    <Border DockPanel.Dock="Right"
                                                            Background="{Binding Status, Converter={StaticResource StatusBgBrush}}"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusFgBrush}}" />
                                                    </Border>

                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="{Binding ValueText}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusFgBrush}}"
                                                           Margin="0,5,0,6" />

                                                <TextBlock Text="{Binding SourceFile, StringFormat=Source: {0}}"
                                                           Foreground="{StaticResource BrushTextMuted}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ExtractionMethod, StringFormat=Method: {0}}"
                                                           Foreground="{StaticResource BrushTextMuted}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Notes}"
                                                           Visibility="{Binding Notes, Converter={StaticResource NullToVis}}"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Visibility="{Binding InspectorNotes, Converter={StaticResource NullToVis}}"
                                    Background="{StaticResource BrushUnresolvedBg}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,8"
                                    Margin="0,4,0,0">
                                <TextBlock Text="{Binding InspectorNotes}"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ROW 3: Collapsible Diagnostics Log Drawer -->
        <Border Grid.Row="3"
                Visibility="{Binding IsDiagnosticsOpen, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Height="185">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="14,7,10,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopyDiagnosticsCommand}"
                                Content="Copy Log"
                                Padding="9,3"
                                FontSize="11.5"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleDiagnosticsCommand}"
                                ToolTip="Close diagnostics drawer">
                            <Path Data="{StaticResource IconClose}" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="DIAGNOSTICS LOG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Diagnostics}"
                         Background="{StaticResource BrushBgWindow}"
                         BorderThickness="0,1,0,0"
                         BorderBrush="{StaticResource BrushBorder}"
                         FontFamily="{StaticResource FontMono}"
                         FontSize="11.5"
                         Padding="8,4"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,2">
                                <TextBlock Text="{Binding Severity}"
                                           Foreground="{Binding Severity, Converter={StaticResource DiagSeverityBrush}}"
                                           FontWeight="SemiBold"
                                           Width="64" />
                                <TextBlock Text="{Binding Category, StringFormat=[{0}]}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Message}"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ROW 4: Compact Status Bar -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Toast badge -->
                    <Border Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource BrushAccentSubtle}"
                            BorderBrush="{StaticResource BrushAccent}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource BrushAccent}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding ToastMessage}" FontSize="11.5" Foreground="#93C5FD" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding DurationDisplay}"
                               Visibility="{Binding DurationDisplay, Converter={StaticResource NullToVis}}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="11.5"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />

                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleDiagnosticsCommand}"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DiagnosticCount, StringFormat=Diagnostics ({0})}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="620" />

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
                                Margin="14,0,0,0">
                        <TextBlock Text="·" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ConfirmedOffsetsCount, StringFormat={}{0:N0} confirmed}" Foreground="{StaticResource BrushConfirmed}" FontSize="11.5" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PartialOffsetsCount, StringFormat={}{0:N0} partial}" Foreground="{StaticResource BrushPartial}" FontSize="11.5" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding UnresolvedOffsetsCount, StringFormat={}{0:N0} unresolved}" Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Full-Window Drag-and-Drop Overlay -->
        <Border x:Name="DragOverlay"
                Grid.RowSpan="5"
                Visibility="Collapsed"
                Background="#CC0F1115"
                BorderBrush="{StaticResource BrushAccent}"
                BorderThickness="2"
                Margin="8"
                CornerRadius="8"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccent}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,12" />
                <TextBlock Text="Drop Game Folder or Binary to Inspect" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Supports Unity IL2CPP, Unity Mono, GameAssembly.dll, global-metadata.dat, PE, and ELF files" Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
